# Consumed by docker-compose.yml only. Copy to .env before `docker compose up -d`.
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports
POSTGRES_DB=sports_articles

# Host port the container publishes on. Change this only if 5432 is already taken
# on your machine (e.g. a native Postgres install); then update DATABASE_URL in
# apps/backend/.env to match.
POSTGRES_PORT=5432
