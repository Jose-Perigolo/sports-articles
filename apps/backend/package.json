{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern . --max-warnings 0",
    "seed": "tsx src/seed.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "db:generate": "pnpm run typeorm migration:generate -d src/data-source.ts",
    "db:migrate": "pnpm run typeorm migration:run -d src/data-source.ts",
    "db:revert": "pnpm run typeorm migration:revert -d src/data-source.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "graphql": "^16.14.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
